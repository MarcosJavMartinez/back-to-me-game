{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-dist",
    "rootDir": ".",
    "noEmit": false,
    "target": "es2020",
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "lib/activitySchedule.ts",
    "lib/dateUtils.ts",
    "lib/i18n.ts",
    "lib/rewards.ts",
    "lib/stats.ts",
    "lib/types.ts"
  ],
  "exclude": ["node_modules"]
}
